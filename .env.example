# ===== Panel admin berita (/admin) =====
# Kredensial bawaan: nama YRISUMSEL. Disarankan menggantinya (terutama bila repo GitHub bersifat publik):
ADMIN_USER=YRISUMSEL
ADMIN_PASSWORD=ganti-dengan-password-kuat
# Kunci penanda sesi login (isi teks acak panjang)
ADMIN_SESSION_SECRET=isi-teks-acak-yang-panjang

# ===== Penyimpanan di production (Vercel) =====
# CMS menyimpan berita dengan commit ke GitHub, lalu Vercel build ulang otomatis.
# Token: GitHub > Settings > Developer settings > Fine-grained tokens > akses repo ini, izin "Contents: Read and write".
GITHUB_TOKEN=github_pat_xxx
GITHUB_REPO=Darren0099/YOUTHRANGERINDONESIASUMATERASELATAN
GITHUB_BRANCH=main
# Jika proyek berada di subfolder repo, isi nama foldernya (kosongkan bila proyek ada di root repo)
# GITHUB_DATA_DIR=

# ===== Lokal (npm run dev) =====
# Tanpa GITHUB_TOKEN, CMS otomatis menulis langsung ke file di folder proyek.
# Paksa mode: CMS_STORAGE=local atau CMS_STORAGE=github
